{
  "mcpServers": {
    "filesystem": {
      "command": ".venv/bin/python",
      "args": [
        "-m", "chainwatch",
        "--server", "filesystem",
        "--observe-only",
        "--label", "benign",
        "--source", "devwork",
        "--",
        "npx", "-y", "@modelcontextprotocol/server-filesystem", "${HOME}/Documents"
      ]
    },
    "memory": {
      "command": ".venv/bin/python",
      "args": [
        "-m", "chainwatch",
        "--server", "memory",
        "--observe-only",
        "--label", "benign",
        "--source", "devwork",
        "--",
        "npx", "-y", "@modelcontextprotocol/server-memory@2026.1.26"
      ]
    },
    "context7": {
      "command": ".venv/bin/python",
      "args": [
        "-m", "chainwatch",
        "--server", "context7",
        "--observe-only",
        "--label", "benign",
        "--source", "devwork",
        "--",
        "npx", "-y", "@upstash/context7-mcp@2.1.4"
      ]
    }
  }
}
